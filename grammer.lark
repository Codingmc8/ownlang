start: unit*

unit: args
    | echo_stmt
    | if_stmt
    | for_stmt
    | func_stmt
    | return_stmt
    | break_stmt
    | continue_stmt
    | typedef_stmt
    | expr_stmt

args: "let" CNAME "=" (expr | range_expr)   -> register
    | "let" CNAME                           -> empty_value
    | "let" CNAME "=" array                 -> let_array
    | "let" CNAME "=" dict                  -> let_dict
    | CNAME "=" value                       -> update
    | CNAME "+=" value                      -> add_equal
    | CNAME "-=" value                      -> min_equal
    | CNAME "*=" value                      -> mul_equal
    | CNAME "/=" value                      -> div_equal
    | CNAME "^=" value                      -> domain_equal
    | obj_acc                               -> obj_assign
    | CNAME CNAME "=" (expr | range_expr | array | dict) -> typed_register
    | CNAME CNAME                           -> typed_default_register

?value: expr
      | array
      | dict

array: "[" [array_element ("," array_element)*] "]"
?array_element: value | range_expr

dict: "{" [pair ("," pair)*] "}"
pair: CNAME ":" value
obj_acc: CNAME "." CNAME "=" expr -> obj_assignment

AT: "@"
NULL: "null"

?expr: ternary

?ternary: logic_or
        | logic_or "?" expr ":" ternary -> ternary_logic

?logic_or: logic_and
         | logic_or "||" logic_and -> or_logic

?logic_and: comparison
          | logic_and "&&" comparison -> and_logic

?comparison: sum
           | comparison "==" sum -> d_equal
           | comparison "!=" sum -> n_equal
           | comparison "<" sum  -> less_than
           | comparison ">" sum  -> greater_than
           | comparison "<=" sum -> lt_equal
           | comparison ">=" sum -> gt_equal

?sum: product
    | sum "+" product -> add
    | sum "-" product -> sub

?product: power
        | product "*" power -> mul
        | product "/" power -> div

?power: unary
      | unary "^" power -> domain

?unary: "!" unary -> not_logic
      | atom

?atom: NUMBER -> number
     | CNAME "(" [expr ("," expr)*] ")" -> func_call
     | CNAME -> var
     | CNAME "[" expr "]" -> arr_index
     | CNAME "." CNAME -> obj_access
     | STRING -> string
     | BOOLEAN -> boolean
     | "(" expr ")"
     | AT -> arg_base
     | AT NUMBER -> arg_base_index
     | NULL -> null_expr

echo_stmt: "echo" echo_item ("," echo_item)*
?echo_item: expr | range_expr

if_stmt: "if" "(" expr ")" body ("else" body)? -> if_stmt
for_stmt: "for" "(" (expr | range_expr) ")" body

func_stmt: "func" CNAME "(" param ")" body -> reg_func
return_stmt: "return" (expr | range_expr)

break_stmt: "break"
continue_stmt: "continue"

typedef_stmt: "typedef" CNAME (":" (expr | range_expr | array | dict))? -> typedef_stmt
expr_stmt: expr

?body: block | unit

block: "{" unit* "}"
param: [param_item ("," param_item)* ("," "...")?] -> param_def
     | "..." -> rest_only

param_item: CNAME ("=" expr)? -> param_with_default
range_expr: atom DOTDOT atom

BOOLEAN.2: "true" | "false"
STRING: /"[^"]*"/
DOTDOT: ".."

%import common.NUMBER
%import common.CNAME
%import common.ESCAPED_STRING
%import common.WS

COMMENT: /\/\/[^\n]*/
MULTI_COMMENT: /\/\*[\s\S]*?\*\//

%ignore COMMENT
%ignore MULTI_COMMENT
%ignore WS
